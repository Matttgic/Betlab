PORT=8787

# Local SQLite database. Used automatically when Supabase vars are absent.
DATABASE_PATH=./data/betlab.db

# Optional read-only connection to production Supabase.
# Use the publishable key only. No service-role key or ingestion secret belongs in the app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
